# Base URL for the NexaChat REST API. Must include the /api suffix.
# The Socket.io origin is derived from this by stripping the path.
NEXT_PUBLIC_API_URL=https://frontend-task-chatapp.onrender.com/api

# Canonical origin, used for canonical tags, the sitemap, robots.txt and social
# cards. Set this per environment so a preview deploy does not advertise itself
# as production. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nexachat.vercel.app
